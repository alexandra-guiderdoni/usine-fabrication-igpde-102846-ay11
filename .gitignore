# Système et éditeurs
.DS_Store
._*
~$*

# Python et environnement
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Sorties régénérables
.qa/
tmp/
outputs/
/support-formation-*.pptx

# Pack livrable : installeurs récupérés par make outils (voir outils/outils.json)
IGPDE-*-livrables-*/outils/*
!IGPDE-*-livrables-*/outils/MANIFEST.md
!IGPDE-*-livrables-*/outils/outils.json
*.partiel

# Clone de travail du dépôt du site (publié par make publier-site)
IGPDE-*-livrables-*/Formateur/tp-easy-check-site-web-igpde/

# Convocation nominative des intervenants : conservée sur disque, hors du dépôt
convocation-intervenants.pdf
